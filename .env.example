# ─────────────────────────────────────────────────────────────
# Flower & Love — Environment Variables
# Copy this file to `.env.local` for local development and fill
# in real values. Never commit `.env.local` or any file containing
# real secrets to version control.
# ─────────────────────────────────────────────────────────────

# Supabase (added in Phase 2 — Authentication & Database)
# Project URL and anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is SECRET. Server-side only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Business WhatsApp number used platform-wide for support, orders and
# payment coordination. Digits only, with country code, no "+" or spaces.
# Example below is Flower & Love's business number: +216 94 409 166
NEXT_PUBLIC_BUSINESS_WHATSAPP=21694409166

# Public site URL — used to build invitation share links, QR codes and
# Open Graph metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
