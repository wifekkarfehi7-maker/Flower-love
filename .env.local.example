NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clé service_role : côté serveur uniquement, ne jamais l'exposer au navigateur.
# Sert à enregistrer les commandes des clients attablés (qui n'ont pas de compte).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
